@startuml comunicacion-ejecutar-orden
!include estilo.iuml
title SIGEV · Diagrama de comunicación: Ejecutar y cerrar una orden
left to right direction

actor ":Técnico" as T
rectangle "<u>:DetalleOrden</u>" as V
rectangle "<u>:ControladorOrdenes</u>" as C
rectangle "<u>ot3:Orden</u>" as O
rectangle "<u>:Pausa</u>" as P
rectangle "<u>:EventoOrden</u>" as E
rectangle "<u>:Auditoria</u>" as A

T -- V : "1: iniciar()  2: pausar(motivo)\n3: reanudar()  4: cerrar(diagnóstico, solución) →"
V -- C : "1.1: iniciar(id)  2.1: pausar(id, motivo)\n3.1: reanudar(id)  4.1: cerrar(id, datos) →"
C -- O : "1.2: cambiarEstado(\"En ejecución\")\n2.2: cambiarEstado(\"Suspendida\")\n4.2: validarEstado()  4.3: finalizar(datos) →"
C -- P : "2.3: crear(motivo, inicio)\n3.2: terminar(fin) →"
O -- P : "4.4: calcularTiempoReal() →"
C -- E : "1.3 / 2.4 / 3.3 / 4.5: registrar(tipo) →"
C -- A : "1.4 / 2.5 / 3.4 / 4.6: registrar(usuario, acción) →"
@enduml
