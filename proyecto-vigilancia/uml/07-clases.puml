@startuml clases
!include estilo.iuml
title SIGEV · Diagrama de clases del dominio (apoyo)
hide empty methods

class Usuario {
  nombre
  usuario
  rol : {admin, director, tecnico, almacenista}
  activo
}
class Cliente {
  nombre
  identificacion
  activo
}
class Cuenta {
  nombre
  direccion
  contacto
  correo
  ruta
  activo
}
class Capacidad {
  nombre
}
class Tecnico {
  nombre
  documento
  celular
  activo
}
class Plantilla {
  nombre
  prioridad
  tiempoEstimado
}
class Orden {
  consecutivo
  estado
  prioridad
  programadaPara
  inicio
  fin
  diagnostico
  solucion
  --
  asignar()
  iniciar()
  pausar()
  reanudar()
  cerrar()
  anular()
  tiempoReal()
}
class Pausa {
  motivo
  inicio
  fin
}
class EventoOrden {
  fecha
  tipo
  detalle
}
class Articulo {
  codigo
  nombre
  unidad
  tipo : {Recuperable, Consumible}
  existenciaMinima
}
class Bodega {
  nombre
  tipo : {Principal, Cuenta}
}
class Movimiento {
  tipo : {Entrada, Traslado}
  fecha
  cantidad
  proveedor
  factura
}
class Auditoria {
  fecha
  usuario
  modulo
  accion
  detalle
}

Cliente "1" *-- "1..*" Cuenta
Cuenta "1" -- "1" Bodega
Usuario "0..1" -- "0..1" Tecnico
Tecnico "*" -- "*" Capacidad
Plantilla "*" --> "0..1" Capacidad : requiere
Orden "*" --> "1" Cuenta
Orden "*" --> "1" Plantilla
Orden "*" --> "0..1" Tecnico
Orden "1" *-- "*" Pausa
Orden "1" *-- "*" EventoOrden
Movimiento "*" --> "1" Articulo
Movimiento "*" --> "0..1" Bodega : origen
Movimiento "*" --> "1" Bodega : destino
Movimiento "*" --> "0..1" Orden
@enduml
